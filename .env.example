# Which provider the agent module should call: "openai" or "gemini"
LLM_PROVIDER=gemini

# Copy this file to .env before running the project.
# Add your own API key.
# Never commit your actual .env file to GitHub.

# Only one is required depending on LLM_PROVIDER
OPENAI_API_KEY=
GEMINI_API_KEY=

# Model names
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash

# SQLite database location
DB_PATH=./data/guardrail.db

# Guardrail policy configuration
POLICY_FILE=./backend/policy.yaml

# Application settings
APP_ENV=development
LOG_LEVEL=INFO