# Which provider the agent module should call: "openai" or "gemini"
LLM_PROVIDER=gemini

# Only one of these is required, matching LLM_PROVIDER above
OPENAI_API_KEY=
GEMINI_API_KEY=

# Model names
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash

# Where the SQLite file lives (mounted to a persistent volume once deployed)
DB_PATH=./data/guardrail.db

# Path to the declarative policy file
POLICY_FILE=./backend/policy.yaml

# App
APP_ENV=development
LOG_LEVEL=INFO
